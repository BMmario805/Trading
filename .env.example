# Copiar a .runtime/gemini.env; el backend carga ese archivo automáticamente.
# Nunca guardar la clave real en este ejemplo ni en el frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SYMBOLS=XAUUSD,BTC,ETH
GEMINI_MAX_REQUESTS_DAY=48
GEMINI_MAX_REQUESTS_HOUR=6
GEMINI_INTERVAL_SECONDS=900
GEMINI_MIN_REQUEST_SECONDS=1800

# Enjambre: copiar este bloque a .runtime/swarm.env. Claves solo en el servidor.
XAI_API_KEY=
OPENAI_API_KEY=
SWARM_ENABLED=1
SWARM_TRANSPORT=subscription
SWARM_MODE=shadow
SWARM_ARM=0
SWARM_MAX_DAY=16
SWARM_MAX_HOUR=4
SWARM_MONTHLY_CAP_USD=15
OPENAI_RISK_MODEL=o3-mini
OPENAI_RISK_FALLBACK=gpt-4o
